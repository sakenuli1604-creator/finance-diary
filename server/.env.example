# Database
DATABASE_URL="postgresql://finance_user:finance_password@localhost:5432/finance_diary"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=5000
NODE_ENV=development

# Cloudinary (опционально, для загрузки фото)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Сброс пароля по email (отправка по HTTPS API — на Railway Hobby SMTP закрыт)
# Адрес фронтенда — из него строится ссылка в письме
APP_URL=https://your-frontend.up.railway.app
# Адрес отправителя: для Brevo — подтверждённый в Brevo Sender, для Resend — адрес на подтверждённом домене
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Финансовый дневник
# Достаточно ОДНОГО из двух ключей (если заданы оба — используется Brevo)
BREVO_API_KEY=
RESEND_API_KEY=
